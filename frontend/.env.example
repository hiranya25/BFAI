# Backend base URL (no trailing slash). Read only by server-side API routes,
# never sent to the browser. e.g. https://<user>-<space>.hf.space
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Must equal the backend's API_SECRET_KEY.
API_SECRET_KEY=replace-with-the-backend-api-secret

# Per-file upload limit shown/enforced in the browser. Keep <= 4 on Vercel
# (its functions reject request bodies over ~4.5MB) and <= backend MAX_UPLOAD_MB.
NEXT_PUBLIC_MAX_UPLOAD_MB=4

# Optional: require a login for the whole site (HTTP Basic Auth). Leave empty for an open site.
APP_USERNAME=admin
APP_PASSWORD=
