# --- LLM providers -----------------------------------------------------------
# Groq is primary; Gemini is the fallback after GROQ_MAX_ATTEMPTS failed attempts.
# At least one key is required; set both for resilience.
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key

# Models (override when a provider deprecates one — no code change needed).
GROQ_TEXT_MODEL=openai/gpt-oss-20b
# Groq has no production vision model; this one is preview. Leave empty to send
# scanned pages straight to Gemini.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GEMINI_MODEL=gemini-3.8-flash
GROQ_MAX_ATTEMPTS=3
GEMINI_MAX_ATTEMPTS=2
LLM_TIMEOUT_SECONDS=60

# --- Security -----------------------------------------------------------------
# Long random string shared with the frontend (API_SECRET_KEY there too).
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET_KEY=replace-with-a-long-random-api-secret
# Fernet key for encrypting uploads at rest. Keep it stable: changing it makes
# existing encrypted files unreadable.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-a-fernet-key

# --- Storage & limits -----------------------------------------------------------
UPLOAD_DIR=./data/raw_docs
THUMBNAIL_DIR=./data/thumbnails
CHROMA_DIR=./data/chroma_db
MAX_UPLOAD_MB=20
# Comma-separated. The frontend calls the backend server-side, so this mainly
# matters if a browser ever calls the API directly.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
